#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

const uint8_t LED_PIN_R = 0;
const uint8_t LED_PIN_Y = 2;
const uint8_t LED_PIN_G = 12;

const uint8_t BUTTON_LOCAL = 14;

ESP8266WebServer server(80);

// ===== WIFI =====
const char* ssid = "Wemos_Network";
const char* password = "12345678";

// ===== UART COMMAND =====
const char UART_COMMAND = 'D';

// ===== ALGORITHM =====
bool isPaused = false;
unsigned long pauseStartTime = 0;

const uint32_t pauseDuration = 15000;
const uint16_t stepDelay = 350;

uint32_t lastStepTime = 0;
uint8_t stepIndex = 0;
int8_t activeLED = -1;

// =====================================================
// HTML PAGE
// =====================================================

void handleRoot() {
  String html = R"rawliteral(
  <html>
  <head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>

    <style>
      body{
        background:#1e1e1e;
        color:white;
        text-align:center;
        font-family:Arial;
        margin-top:40px;
      }

      button{
        width:220px;
        height:70px;
        margin:15px;
        border:none;
        border-radius:15px;
        font-size:20px;
        cursor:pointer;
        color:white;
        transition: 0.2s;
      }

      button:active {
        transform: scale(0.95);
      }

      .local{ background:#2ecc71; }
      .uart{ background:#e67e22; }

      .status{
        margin-top:30px;
        font-size:24px;
        font-weight: bold;
      }

      /* Стилі для світлодіодів */
      .led-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 40px;
      }

      .led {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #333; /* Вимкнений стан */
        box-shadow: inset 0px 5px 10px rgba(0,0,0,0.5);
        transition: 0.1s;
      }

      /* Активні стани для кожного кольору */
      .led.active-r { background-color: #ff3b30; box-shadow: 0 0 20px #ff3b30; }
      .led.active-y { background-color: #ffcc00; box-shadow: 0 0 20px #ffcc00; }
      .led.active-g { background-color: #34c759; box-shadow: 0 0 20px #34c759; }

    </style>
  </head>

  <body>

    <h1>ESP8266 CONTROL</h1>

    <button class='local' onclick="fetch('/local')">
      LOCAL START
    </button>
    <br>
    <button class='uart' onclick="fetch('/uart')">
      SEND UART COMMAND
    </button>

    <div class='status'>
      Status: <span id='statusText'>WORKING</span>
    </div>

    <div class='led-container'>
      <div id='led0' class='led'></div>
      <div id='led1' class='led'></div>
      <div id='led2' class='led'></div>
    </div>

    <script>
      // Опитуємо частіше (кожні 150 мс), щоб анімація була плавною
      setInterval(() => {
        fetch('/status')
        .then(response => response.json())
        .then(data => {
          document.getElementById('statusText').innerText = data.status;


          document.getElementById('led0').className = 'led';
          document.getElementById('led1').className = 'led';
          document.getElementById('led2').className = 'led';


          if (data.led === 0) document.getElementById('led0').classList.add('active-r');
          if (data.led === 1) document.getElementById('led1').classList.add('active-y');
          if (data.led === 2) document.getElementById('led2').classList.add('active-g');
        })
        .catch(err => console.log("Connection error"));
      }, 150);
    </script>

  </body>
  </html>
  )rawliteral";

  server.send(200, "text/html", html);
}

// =====================================================
// LOCAL ALGORITHM START
// =====================================================

void startPauseAlgorithm() {
  isPaused = true;
  activeLED = -1;
  pauseStartTime = millis();


  digitalWrite(LED_PIN_R, LOW);
  digitalWrite(LED_PIN_Y, LOW);
  digitalWrite(LED_PIN_G, LOW);
}

void handleLocalButton() {
  startPauseAlgorithm();
  server.send(200, "text/plain", "LOCAL START");
}

// =====================================================
// UART SEND
// =====================================================

void handleUARTButton() {
  Serial.write(UART_COMMAND);
  server.send(200, "text/plain", "UART SENT");
}

// =====================================================
// STATUS
// =====================================================

void handleStatus() {
  String jsonResponse = "{";

  if(isPaused) {
    jsonResponse += "\"status\":\"PAUSED 15 SEC\", \"led\":-1";
  } else {
    jsonResponse += "\"status\":\"WORKING\", \"led\":" + String(activeLED);
  }

  jsonResponse += "}";

  server.send(200, "application/json", jsonResponse);
}

// =====================================================
// UART RECEIVE
// =====================================================

void checkUART() {
  while(Serial.available()) {
    char incoming = Serial.read();


    if(incoming == '\n' || incoming == '\r' || incoming == 0 || incoming == 255) {
      continue;
    }

    if(incoming == UART_COMMAND) {
      startPauseAlgorithm();

      while(Serial.available()) Serial.read();
      break;
    }
  }
}

// =====================================================
// LED ANIMATION
// =====================================================

void updateLEDs() {
  if(isPaused) {
    if(millis() - pauseStartTime >= pauseDuration) {
      isPaused = false;
    }
    return;
  }

  if(millis() - lastStepTime >= stepDelay) {
    lastStepTime = millis();

    digitalWrite(LED_PIN_R, LOW);
    digitalWrite(LED_PIN_Y, LOW);
    digitalWrite(LED_PIN_G, LOW);

    activeLED = stepIndex;

    switch(stepIndex) {
      case 0:
        digitalWrite(LED_PIN_R, HIGH);
        break;
      case 1:
        digitalWrite(LED_PIN_Y, HIGH);
        break;
      case 2:
        digitalWrite(LED_PIN_G, HIGH);
        break;
    }

    stepIndex = (stepIndex + 1) % 3;
  }
}

// =====================================================
// HARDWARE BUTTON
// =====================================================

void checkHardwareButton() {
  if(digitalRead(BUTTON_LOCAL) == HIGH && !isPaused) {
    startPauseAlgorithm();
    delay(300);
  }
}

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  pinMode(LED_PIN_R, OUTPUT);
  pinMode(LED_PIN_Y, OUTPUT);
  pinMode(LED_PIN_G, OUTPUT);

  pinMode(BUTTON_LOCAL, INPUT);

  // WIFI AP MODE
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  // WEB SERVER
  server.on("/", handleRoot);
  server.on("/local", handleLocalButton);
  server.on("/uart", handleUARTButton);
  server.on("/status", handleStatus);
  server.begin();
}

// =====================================================
// LOOP
// =====================================================

void loop() {
  server.handleClient();
  checkUART();
  checkHardwareButton();
  updateLEDs();
}