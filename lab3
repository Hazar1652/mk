const char* ssid = "iPhone";
const char* password = "Hazar10877";

// --- Telegram налаштування ---
const String botToken = "8952953153:AAFobF52cVLMw9bKosSfuos5ZMHeLPoIFz8";
const String chatId = "735363175"; // Твій ID

WiFiClientSecure client_secure;
UniversalTelegramBot bot(botToken, client_secure);
ESP8266WebServer server(80);

// --- Піни ---
const int mq2Pin = D1; const int buttonPin = D2;
const int greenLed = D4; const int redLed = D5;
const int buzzerPin = D6; const int relayPin = D7;

// --- Стан системи ---
bool isSystemInAlarm = false;
bool manualResetRequired = false;
bool testModeActive = false;
unsigned long testEndTime = 0;
unsigned long lastBotCheck = 0;
const unsigned long botInterval = 2000; // Перевірка ТГ кожні 2 сек

// --- ФУНКЦІЇ КЕРУВАННЯ (Об'єднані для Web та TG) ---

void clearAlarm(String source) {
  // 1. МИТТЄВА ФІЗИКА (Жодної затримки!)
  isSystemInAlarm = false; manualResetRequired = false; testModeActive = false;
  digitalWrite(buzzerPin, LOW); digitalWrite(relayPin, LOW);
  digitalWrite(redLed, LOW); digitalWrite(greenLed, HIGH);

  Serial.println("--- SYSTEM RESET BY " + source + " ---");

  // 2. СПОВІЩЕННЯ (Після того як залізо замовкло)
  bot.sendMessage(chatId, "✅ СИСТЕМА СКИНУТА (" + source + ")", "");
}

void activateTest(String source) {
  isSystemInAlarm = true; testModeActive = true; testEndTime = millis() + 15000;
  digitalWrite(buzzerPin, HIGH); digitalWrite(relayPin, HIGH);
  digitalWrite(redLed, HIGH); digitalWrite(greenLed, LOW);

  bot.sendMessage(chatId, "🛠 ЗАПУЩЕНО ТЕСТ (" + source + ")", "");
}

// --- ОБРОБКА TELEGRAM ---
void handleNewMessages(int numNewMessages) {
  for (int i = 0; i < numNewMessages; i++) {
    String text = bot.messages[i].text;
    if (text == "/reset") clearAlarm("Telegram");
    if (text == "/test") activateTest("Telegram");
    if (text == "/status") {
      String msg = isSystemInAlarm ? "🚨 ТРИВОГА!" : "✅ СТАН: НОРМА";
      bot.sendMessage(chatId, msg, "");
    }
  }
}

