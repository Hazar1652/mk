void setup() {
  Serial.begin(115200);
  pinMode(mq2Pin, INPUT); pinMode(buttonPin, INPUT_PULLUP);
  pinMode(greenLed, OUTPUT); pinMode(redLed, OUTPUT);
  pinMode(buzzerPin, OUTPUT); pinMode(relayPin, OUTPUT);
  digitalWrite(greenLed, HIGH);

  client_secure.setInsecure();
  WiFi.begin(ssid, password);

  // PuTTY показуватиме крапки, поки не підключиться
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }

  Serial.println("\n--- CONNECTED ---");
  Serial.print("IP ADDR: "); Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/status", [](){
    String json = "{\"alarm\":" + String(isSystemInAlarm ? "true" : "false") + "}";
    server.send(200, "application/json", json);
  });
  server.on("/reset", [](){ clearAlarm("Web Panel"); server.send(200, "text/plain", "OK"); });
  server.on("/test", [](){ activateTest("Web Panel"); server.send(200, "text/plain", "OK"); });

  server.begin();
  bot.sendMessage(chatId, "🛡 GUARD PRO ONLINE\nIP: " + WiFi.localIP().toString(), "");
}

void loop() {
  server.handleClient();

  // Telegram опитування
  if (millis() - lastBotCheck > botInterval) {
    int num = bot.getUpdates(bot.last_message_received + 1);
    while (num) { handleNewMessages(num); num = bot.getUpdates(bot.last_message_received + 1); }
    lastBotCheck = millis();
  }

  // Робота датчика
  if (digitalRead(mq2Pin) == LOW && !manualResetRequired) {
    isSystemInAlarm = true; manualResetRequired = true;
    digitalWrite(buzzerPin, HIGH); digitalWrite(relayPin, HIGH);
    digitalWrite(redLed, HIGH); digitalWrite(greenLed, LOW);
    Serial.println("!!! GAS DETECTED !!!");
    bot.sendMessage(chatId, "🚨🚨🚨 УВАГА: ВИЯВЛЕНО ГАЗ!", "");
  }

  // Фізична кнопка
  if (digitalRead(buttonPin) == LOW) {
    delay(50); // антибрязк
    if (manualResetRequired) clearAlarm("Physical Button");
  }

  // Автовимкнення тесту
  if (isSystemInAlarm && testModeActive && millis() > testEndTime) {
    clearAlarm("Auto-Timer");
  }
}