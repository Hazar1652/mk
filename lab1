#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// Визначення пінів (використовуємо const uint8_t для економії пам'яті)
const uint8_t LED_PIN_R = 0;
const uint8_t LED_PIN_Y = 2;
const uint8_t LED_PIN_G = 12;
const uint8_t BUTTON    = 14;

ESP8266WebServer server(80);

// Налаштування таймерів та станів
unsigned long pauseStartTime = 0;
bool isPaused = false;

const uint32_t pauseDuration = 15000; // 15 секунд
const uint16_t stepDelay = 350;       // Затримка між світлодіодами

uint32_t lastStepTime = 0;
uint8_t stepIndex = 0;

// --- 1. Функції Веб-інтерфейсу ---

void handleRoot() {
  String html = "<html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<style>body{text-align:center; background:#222; color:#fff; font-family:sans-serif;}";
  html += ".btn{width:150px; height:150px; border-radius:50%; border:none; background:#ff4444; color:#fff; font-size:20px; font-weight:bold; cursor:pointer;}";
  html += "</style></head><body>";
  html += "<h2>WEMOS CONTROL</h2>";
  html += "<p>Статус: " + String(isPaused ? "ПАУЗА (15с)" : "ПРАЦЮЄ") + "</p>";
  html += "<button class='btn' onclick=\"fetch('/trigger')\">STOP 15s</button>";
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handleTrigger() {
  isPaused = true;
  pauseStartTime = millis();
  server.send(200, "text/plain", "Paused for 15s");
}

// --- 2. Логічні модулі (винесені з loop) ---

void processWebRequests() {
  server.handleClient();
}

void checkHardwareButton() {
  // Зчитуємо стан кнопки (якщо Pull-down, натискання = HIGH)
  if (digitalRead(BUTTON) == HIGH && !isPaused) {
    isPaused = true;
    pauseStartTime = millis();
    Serial.println("Hardware Button: Pause started");
  }
}

void managePauseTimer() {
  if (isPaused) {
    if (millis() - pauseStartTime >= pauseDuration) {
      isPaused = false;
      Serial.println("Timer: Resume operation");
    }
  }
}

void updateLedAnimation() {
  // Якщо на паузі — нічого не перемикаємо
  if (isPaused) return;

  if (millis() - lastStepTime >= stepDelay) {
    lastStepTime = millis();

    // Скидаємо всі піни в LOW
    digitalWrite(LED_PIN_R, LOW);
    digitalWrite(LED_PIN_Y, LOW);
    digitalWrite(LED_PIN_G, LOW);

    // Вмикаємо потрібний за індексом
    switch (stepIndex) {
      case 0: digitalWrite(LED_PIN_R, HIGH); break;
      case 1: digitalWrite(LED_PIN_Y, HIGH); break;
      case 2: digitalWrite(LED_PIN_G, HIGH); break;
    }

    stepIndex = (stepIndex + 1) % 3;
  }
}

// --- 3. Ініціалізація ---

void setup() {
  Serial.begin(115200);

  pinMode(LED_PIN_R, OUTPUT);
  pinMode(LED_PIN_Y, OUTPUT);
  pinMode(LED_PIN_G, OUTPUT);
  pinMode(BUTTON, INPUT);

  WiFi.mode(WIFI_STA);
  WiFi.begin("032", "deffi723723");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  server.on("/", handleRoot);
  server.on("/trigger", handleTrigger);
  server.begin();

  Serial.println("\nSystem Ready");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
}

// --- 4. Основний цикл (тепер максимально чистий) ---

void loop() {
  processWebRequests();  // Обслуговування WiFi запитів
  checkHardwareButton(); // Опитування фізичної кнопки
  managePauseTimer();    // Перевірка часу паузи
  updateLedAnimation();  // Оновлення вогнів
}